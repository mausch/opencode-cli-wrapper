# --- OpenCode CLI ---------------------------------------------------------
# Absolute path or command name of the `opencode` binary.
# Falls back to "opencode" on PATH when unset (resolution logic lands in P2).
OPENCODE_BIN=opencode

# Per-request wall-clock timeout for a single `opencode run` invocation (ms).
OPENCODE_TIMEOUT_MS=120000

# --- HTTP server ----------------------------------------------------------
PORT=3000
HOST=0.0.0.0

# How long to cache the catalog discovered by `opencode models` (ms).
OPENCODE_MODELS_TTL_MS=300000

# Maximum time to wait for the `opencode models` catalog command (ms).
OPENCODE_MODELS_TIMEOUT_MS=30000

# --- Outbound proxy (opencode CLI) ---------------------------------------
# The opencode binary (Bun) honors native HTTP/HTTPS proxy variables.
# OPENCODE_PROXY_URL applies the same URL to HTTP and HTTPS (convenience).
# OPENCODE_PROXY_URL=http://proxy.corp:8080
#
# Or pass the native variables directly:
# HTTP_PROXY=http://proxy.corp:8080
# HTTPS_PROXY=http://proxy.corp:8080
# ALL_PROXY=http://proxy.corp:8080
#
# Bypass list. Defaults to localhost,127.0.0.1,::1 when a proxy is configured.
# OPENCODE_NO_PROXY=localhost,127.0.0.1,::1,.internal.corp
#
# TLS/CA (passed through the environment):
# NODE_EXTRA_CA_CERTS=/etc/ssl/certs/corp-ca.pem
