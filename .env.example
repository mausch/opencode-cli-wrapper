# --- OpenCode CLI ---------------------------------------------------------
# Absolute path or command name of the `opencode` binary.
# Falls back to "opencode" on PATH when unset (resolution logic lands in P2).
OPENCODE_BIN=opencode

# Per-request wall-clock timeout for a single `opencode run` invocation (ms).
OPENCODE_TIMEOUT_MS=120000

# --- HTTP server ----------------------------------------------------------
PORT=3000
HOST=0.0.0.0

# --- Free-model allowlist (P2) -------------------------------------------
# Optional comma-separated override of the curated free-model allowlist.
# Unset => the built-in allowlist from docs/plan.md §3.3 is used.
# FREE_MODELS=opencode/mimo-v2.6-flash-free,deepseek/deepseek-flash
