# --- OpenCode CLI ---------------------------------------------------------
# Absolute path or command name of the `opencode` binary.
# Falls back to "opencode" on PATH when unset (resolution logic lands in P2).
OPENCODE_BIN=opencode

# Per-request wall-clock timeout for a single `opencode run` invocation (ms).
OPENCODE_TIMEOUT_MS=120000

# --- HTTP server ----------------------------------------------------------
PORT=3000
HOST=0.0.0.0

# How long to cache the catalog discovered by `opencode models` (ms).
OPENCODE_MODELS_TTL_MS=300000

# Maximum time to wait for the `opencode models` catalog command (ms).
OPENCODE_MODELS_TIMEOUT_MS=30000
